#!/usr/bin/env bash
set -euo pipefail
project=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
plugins="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
target="$plugins/renan.wallpaper-cutter"
command -v magick >/dev/null || { echo 'ImageMagick is missing; standard Omarchy installations include it.' >&2; exit 1; }
omarchy plugin validate "$project"
if [[ -e $target || -L $target ]]; then
  [[ $(readlink -f -- "$target") == "$project" ]] || { echo "Refusing to replace $target" >&2; exit 1; }
else
  mkdir -p -- "$plugins"
  ln -s -- "$project" "$target"
fi
omarchy-shell shell rescanPlugins
omarchy plugin enable renan.wallpaper-cutter
printf '%s\n' 'Installed. Open Wallpaper Cutter from the app launcher.'
